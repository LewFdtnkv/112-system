# Development-only credentials. Keep the URL consistent with POSTGRES_*.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_DB=trainer
POSTGRES_PORT=15432
API_PORT=8000
API_CPUS=4
API_WORKERS=4
DB_CPUS=4

# Local Python process. Compose overrides the hostname with "db".
DATABASE_URL=postgresql+asyncpg://trainer:trainer@localhost:15432/trainer
APP_NAME=System-112 API
SQL_ECHO=false

# Generate once: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Use the same secret for all API workers. Do not commit the generated value.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Shared by generation, assessment, recommendations and embeddings.
# Match the CPU budget assigned to the llm container (default: 2 CPUs).
LLM_THREADS=2
# Old prompt snapshots are separate from the current request's KV cache.
# Ollama 0.34.2 defaults to an 8 GiB prompt cache, exceeding our 4 GiB container.
LLM_PROMPT_CACHE_MB=0

# Optional local training PBX: docker compose --profile telephony up -d --build
TELEPHONY_ENABLED=false
ARI_PASSWORD=
# localhost for a single-computer demo; LAN IP and LAN binding for physical phones.
SIP_PUBLIC_ADDRESS=127.0.0.1
SIP_BIND_ADDRESS=127.0.0.1
# auto uses the Asterisk container address only; excludes Docker's NAT gateway.
SIP_LOCAL_NET=auto
TELEPHONY_WS_URL=/sip-ws
# Separate machine-to-machine credentials, not user JWTs.
TELEPHONY_ADAPTER_TOKEN=
SPEECH_GENERATOR_TOKEN=
FRONTEND_BIND_ADDRESS=127.0.0.1

# Optional address lookup and translation; secret keys are passed only to the API.
DADATA_API_KEY=
# Yandex Cloud service-account API key (not the browser Maps key).
YANDEX_TRANSLATE_API_KEY=
# Optional explicit translation billing folder.
YANDEX_CLOUD_FOLDER_ID=
EXTERNAL_SERVICES_TIMEOUT_SECONDS=8
# Public JavaScript Maps 2.1 key, restricted to frontend domains; sent only to Nginx.
VITE_YANDEX_MAPS_API_KEY=
