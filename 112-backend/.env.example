# Скопируйте в .env. Ниже безопасные значения для локального стенда, не рабочие секреты.
# Compose читает файл из этой папки. После изменений: docker compose up -d.
# Если включён SIP, используйте docker compose --profile telephony up -d.

# База данных. На сервере замените пароль; POSTGRES_* задают реквизиты при создании БД.
# В уже созданной БД смена этих значений сама по себе не меняет пароль роли.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_DB=trainer
POSTGRES_PORT=15432
DB_CPUS=4
# Для API на хосте. В Compose адрес собирается из POSTGRES_* с хостом db:5432.
# При смене реквизитов обновите и URL. Compose собирает URL автоматически:
# для POSTGRES_PASSWORD используйте буквы/цифры, например результат openssl rand -hex 32.
DATABASE_URL=postgresql+asyncpg://trainer:trainer@localhost:15432/trainer

# API и интерфейс. API и БД публикуются только на 127.0.0.1.
APP_NAME=System-112 API
API_PORT=8000
API_CPUS=4
# Число процессов API; это не лимит числа учеников.
API_WORKERS=4
FRONTEND_PORT=8080
# 0.0.0.0 открывает интерфейс для других компьютеров; для сервера нужен HTTPS-прокси.
FRONTEND_BIND_ADDRESS=127.0.0.1
# Подробный SQL-лог нужен только для отладки.
SQL_ECHO=false
# Абсолютный путь внутри API-контейнера, подключённый к тому журналов.
# При смене путей томов обеспечьте запись пользователю контейнера (UID 10001).
# API на хосте по умолчанию пишет в var/log; иной путь задайте через export.
SYSTEM_LOG_DIRECTORY=/home/appuser/logs

# Авторизация. Обязательно заполните JWT_SECRET_KEY: openssl rand -hex 32
# Один и тот же секрет нужен всем процессам. Смена секрета/issuer/audience сбрасывает входы.
JWT_SECRET_KEY=
JWT_ISSUER=system112
JWT_AUDIENCE=system112-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ИИ. llm — имя сервиса в Docker; для внешнего Ollama укажите его доступный URL.
LLM_BASE_URL=http://llm:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT_SECONDS=300
LLM_CPUS=2
LLM_MEMORY_LIMIT=4g
# Потоки вычисления должны соответствовать выделенным CPU, иначе возможны таймауты.
LLM_THREADS=2
# Одновременные запросы к модели; увеличение требует больше памяти.
LLM_PARALLEL_REQUESTS=1
# МБ для кэша прошлых промптов. 0 отключает его, сохраняя контекст текущего запроса.
# У Ollama 0.34.2 этот кэш иначе может превысить весь лимит контейнера.
LLM_PROMPT_CACHE_MB=0
# Одновременно загруженные модели, длина контекста в токенах и время хранения в RAM.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=60s
# 1 запрещает облачные функции Ollama: используются локальные модели.
OLLAMA_NO_CLOUD=1
# Опрос очереди ИИ-задач в секундах; не время выдачи подсказок ученику.
GENERATION_POLL_SECONDS=2

# Оценивание и рекомендации. Пустая строка MODEL использует LLM_MODEL.
SEMANTIC_ASSESSMENT_ENABLED=true
ASSESSMENT_MODEL=qwen3:4b-instruct-2507-q4_K_M
LEARNING_RECOMMENDATIONS_ENABLED=true
RECOMMENDATION_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Поиск похожих разборов и примеров в памяти ИИ требует загруженной embedding-модели.
ASSESSMENT_RAG_ENABLED=true
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT_SECONDS=120

# Телефония. true включает функции API, но не запускает SIP-сервер само по себе.
# Для встроенного Asterisk: docker compose --profile telephony up -d --build --wait
TELEPHONY_ENABLED=false
# Внутренний API Asterisk. Встроенная АТС использует пользователя trainer.
ARI_URL=http://asterisk:8088/ari
ARI_USERNAME=trainer
# Отдельный случайный пароль длиной от 24 символов: openssl rand -hex 32
# Это пароль связи воркера с АТС, а не пароль SIP-телефона ученика.
ARI_PASSWORD=
# IPv4 сервера, доступный телефону: localhost-стенд 127.0.0.1, в сети — LAN IP сервера.
SIP_PUBLIC_ADDRESS=127.0.0.1
# На каких интерфейсах публиковать UDP 5060 и RTP 10000–10100; для сети — 0.0.0.0.
SIP_BIND_ADDRESS=127.0.0.1
# auto определяет адрес контейнера. Не подставляйте всю Docker-подсеть: это ломает NAT.
SIP_LOCAL_NET=auto
# Обычно пусто: внутренний адрес Asterisk для ICE определяется автоматически.
SIP_ICE_ADDRESS=
# Необязательный домен регистрации телефонов. Compose по умолчанию берёт SIP_PUBLIC_ADDRESS.
# Для API вне Compose значение по умолчанию localhost.
# TELEPHONY_SIP_DOMAIN=localhost
# Относительный путь использует ws/wss страницы; для браузера вне localhost нужен HTTPS.
TELEPHONY_WS_URL=/sip-ws
# Максимальная длительность одного звонка, секунды (30–3600).
TELEPHONY_MAX_CALL_SECONDS=600
# Отдельный токен внешнего адаптера АТС. Для встроенного Asterisk не нужен.
TELEPHONY_ADAPTER_TOKEN=
# Путь внутри API/воркеров для общего тома аудио. Обычно менять не требуется.
TELEPHONY_MEDIA_DIRECTORY=/home/appuser/telephony

# Озвучка. Голос по умолчанию: denis, dmitri, irina или ruslan.
SPEECH_VOICE=denis
# Маркер версии записей заявителя. Меняйте при смене генератора, не для выбора голоса.
SPEECH_GENERATOR_VERSION=piper-1.8.0-v1:caller
# Встроенные модели лежат здесь; иной путь требует собственного монтирования моделей.
SPEECH_MODELS_DIRECTORY=/opt/voices
# Только для внешнего генератора записей; локальному Piper не нужен.
SPEECH_GENERATOR_TOKEN=

# Необязательные внешние сервисы. Пустые ключи оставляют ручной ввод доступным.
DADATA_API_KEY=
# Ключ сервисного аккаунта Yandex Cloud для перевода, не ключ JavaScript-карт.
YANDEX_TRANSLATE_API_KEY=
# Необязательный каталог для оплаты запросов перевода.
YANDEX_CLOUD_FOLDER_ID=
EXTERNAL_SERVICES_TIMEOUT_SECONDS=8
# Публичный ключ JavaScript Maps 2.1, ограниченный доменами интерфейса.
# Он передаётся только frontend; DaData и Translate — только API.
VITE_YANDEX_MAPS_API_KEY=

# Служебные скрипты: переменные ниже задаются через export, не читаются ими из .env.
# Пароль существующего администратора для seed через HTTP; режим --database его не использует.
# DEMO_ADMIN_PASSWORD=admin
# Только отдельная мигрированная тестовая БД, не рабочая.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:test-only@127.0.0.1:15433/trainer_test
# Необязательный путь отчёта scripts/evaluate_teacher_feedback.py.
# TEACHER_FEEDBACK_REPORT=.tmp-teacher-feedback.json
# Параметры нагрузочных проверок вынесены в performance/.env.example.
