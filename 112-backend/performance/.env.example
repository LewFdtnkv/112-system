# Отдельный нагрузочный стенд, не настройки рабочего приложения.
# Compose: из performance/ скопируйте файл в .env и выполните docker compose up -d --build.
PERF_API_IMAGE=system112-performance-api
PERF_API_WORKERS=4

# Переменные Python/Locust задаются через export: скрипты не читают .env сами.
# В Compose load уже использует http://api:8000 и /work/performance/artifacts/manifest.json.
# PERF_HOST=http://127.0.0.1:18000
# PERF_DATA=performance/artifacts/manifest.json
# Разделение учеников между процессами: номер части от 0 до PERF_SHARDS-1.
# PERF_SHARDS=1
# PERF_SHARD=0
# Необязательный путь итогового JSON от Locust.
# PERF_SUMMARY=performance/artifacts/summary.json
